rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isHouseholdMember(householdId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    match /households/{householdId} {
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members;
      allow read, delete: if isHouseholdMember(householdId);
      allow update: if isHouseholdMember(householdId)
        || (
          signedIn()
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['members'])
          && request.auth.uid in request.resource.data.members
        );

      match /{document=**} {
        allow read, write: if isHouseholdMember(householdId);
      }
    }

    match /invites/{inviteId} {
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toEmail is string
        && request.resource.data.householdId is string;

      allow read: if signedIn();

      allow update: if signedIn()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status']);
    }
  }
}
